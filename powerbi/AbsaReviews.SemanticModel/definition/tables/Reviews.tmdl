table Reviews
	lineageTag: c8d3345f-938a-4c65-8fea-53f4f15f7f55

	measure 'Review Count' = COUNTROWS(Reviews)
		formatString: #,0
		lineageTag: 58e0cbd8-81a7-4a1f-af6b-9e5f1cf7f9da

	measure 'Average Rating' = AVERAGE(Reviews[Rating])
		formatString: 0.00
		lineageTag: 9bfe6c69-c542-446d-89be-99897af9c83c

	measure '% Positive' = DIVIDE(CALCULATE(COUNTROWS(Reviews), Reviews[Rating] >= 4), COUNTROWS(Reviews))
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: fc458132-98b7-4344-a6ed-b86856802f39

	measure '% Negative' = DIVIDE(CALCULATE(COUNTROWS(Reviews), Reviews[Rating] <= 2), COUNTROWS(Reviews))
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 9526f8fe-efeb-49ec-af24-5b4e076289d4

	measure 'Android Reply Rate' = DIVIDE(CALCULATE(COUNTROWS(Reviews), Reviews[Replied] = "Yes"), CALCULATE(COUNTROWS(Reviews), Reviews[Store] = "Android"))
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 97c09a3f-8126-408b-ad72-df2e78eeba45

	measure 'Avg Hours to Reply' = AVERAGE(Reviews[Hours to Reply])
		formatString: #,0.0
		lineageTag: 7d7dbf95-6beb-4133-b818-820f7aa7a713

	measure 'Latest Review' = MAX(Reviews[Review Date])
		formatString: dd mmm yyyy hh:nn
		lineageTag: 59a64ad9-44fd-4626-9f7b-84dcaf21e8d6

	column 'Store'
		dataType: string
		lineageTag: afb11c33-89eb-4c70-a59d-1860aaacf1f6
