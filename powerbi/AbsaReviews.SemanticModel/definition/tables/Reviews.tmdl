table Reviews
	lineageTag: 7cf2ab05-9cff-4d78-a7b3-9bf9b09f8e03

	measure 'Review Count' = COUNTROWS(Reviews)
		formatString: #,0
		lineageTag: 9dfef6cc-e012-4bc0-8b64-969c16b2451b

	measure 'Average Rating' = AVERAGE(Reviews[Rating])
		formatString: 0.00
		lineageTag: 691a173b-f377-4e69-ade8-632755e7149c

	measure '% Positive' = DIVIDE(CALCULATE(COUNTROWS(Reviews), Reviews[Sentiment] = "Positive"), CALCULATE(COUNTROWS(Reviews), ALL(Reviews[Sentiment])))
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: f8a9e245-5e17-434d-b5cc-012f1f27b8d8

	measure '% Negative' = DIVIDE(CALCULATE(COUNTROWS(Reviews), Reviews[Sentiment] = "Negative"), CALCULATE(COUNTROWS(Reviews), ALL(Reviews[Sentiment])))
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: caa92e37-0e1a-4b02-9ccf-159669c33a0d

	measure 'Android Reply Rate' = DIVIDE(CALCULATE(COUNTROWS(Reviews), Reviews[Replied] = "Yes"), CALCULATE(COUNTROWS(Reviews), Reviews[Store] = "Android"))
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 8d2b0beb-a665-4a0d-a4ff-813e782647d0

	measure 'Avg Hours to Reply' = AVERAGE(Reviews[Hours to Reply])
		formatString: #,0.0
		lineageTag: 2e107242-087b-42a5-8e49-0a86dffa6860

	measure 'Latest Review' = MAX(Reviews[Review Date])
		formatString: dd mmm yyyy hh:nn
		lineageTag: 5f87808e-5546-4ef9-a8f5-ba3ac5616e3a

	column 'Store'
		dataType: string
		lineageTag: 92184a74-c90d-46ad-96b5-35777bd38939
		summarizeBy: none
		sourceColumn: Store

		annotation SummarizationSetBy = Automatic

	column 'Review ID'
		dataType: string
		lineageTag: 2a41c3dc-526e-4d64-b7b7-bf17c8ecd65f
		summarizeBy: none
		sourceColumn: Review ID

		annotation SummarizationSetBy = Automatic

	column 'Rating'
		dataType: int64
		formatString: 0
		lineageTag: 2109a382-0a28-42ce-bb18-ebc0752f659c
		summarizeBy: none
		sourceColumn: Rating

		annotation SummarizationSetBy = Automatic

	column 'Title'
		dataType: string
		lineageTag: 608e133f-9061-4b84-958a-4fed0de8a429
		summarizeBy: none
		sourceColumn: Title

		annotation SummarizationSetBy = Automatic

	column 'Review'
		dataType: string
		lineageTag: 5b4a57c3-ba6c-4df5-a910-e6ab9aaeada2
		summarizeBy: none
		sourceColumn: Review

		annotation SummarizationSetBy = Automatic

	column 'App Version'
		dataType: string
		lineageTag: 9a3ab677-aa2c-4550-8b0c-6ee6a05cd5dc
		summarizeBy: none
		sourceColumn: App Version

		annotation SummarizationSetBy = Automatic

	column 'Review Date'
		dataType: dateTime
		formatString: dd mmm yyyy hh:nn
		lineageTag: 831e8328-1936-4ed4-90ae-8c5b222c0da1
		summarizeBy: none
		sourceColumn: Review Date

		annotation SummarizationSetBy = Automatic

	column 'Review Day'
		dataType: dateTime
		formatString: dd mmm yyyy
		lineageTag: 85133d18-c830-4e20-bb06-1e50f5537d70
		summarizeBy: none
		sourceColumn: Review Day

		annotation SummarizationSetBy = Automatic

	column 'Month'
		dataType: dateTime
		formatString: mmm yyyy
		lineageTag: b830b7ad-ca72-4258-bb05-05ebbec01330
		summarizeBy: none
		sourceColumn: Month

		annotation SummarizationSetBy = Automatic

	column 'Version'
		dataType: string
		lineageTag: 0fdbe67b-0edb-4204-8d7e-f6ea2749eba0
		summarizeBy: none
		sourceColumn: Version
		sortByColumn: 'Version Sort'

		annotation SummarizationSetBy = Automatic

	column 'Version Sort'
		dataType: int64
		formatString: 0
		lineageTag: 58986774-2675-4c43-8bf7-6621e62bdaff
		summarizeBy: none
		sourceColumn: Version Sort

		annotation SummarizationSetBy = Automatic

	column 'Stars'
		dataType: string
		lineageTag: 0955cd5b-1d42-4120-8a09-20103595052a
		summarizeBy: none
		sourceColumn: Stars
		sortByColumn: 'Rating'

		annotation SummarizationSetBy = Automatic

	column 'Sentiment'
		dataType: string
		lineageTag: cac753e2-9f10-41bc-9534-6c325a3047ce
		summarizeBy: none
		sourceColumn: Sentiment

		annotation SummarizationSetBy = Automatic

	column 'Replied'
		dataType: string
		lineageTag: 59f0fe5a-238a-4808-833d-c6a50a7aba62
		summarizeBy: none
		sourceColumn: Replied

		annotation SummarizationSetBy = Automatic

	column 'Hours to Reply'
		dataType: double
		formatString: #,0.0
		lineageTag: 2a65e35b-4ff7-4f75-8fa9-40d3d95602ba
		summarizeBy: none
		sourceColumn: Hours to Reply

		annotation SummarizationSetBy = Automatic

	column 'Thumbs Up'
		dataType: int64
		formatString: #,0
		lineageTag: 9febf774-e120-49f3-a09d-34a585f11a33
		summarizeBy: sum
		sourceColumn: Thumbs Up

		annotation SummarizationSetBy = Automatic

	column 'ABSA Reply'
		dataType: string
		lineageTag: 04af4610-c060-4797-bf66-b10de1742723
		summarizeBy: none
		sourceColumn: ABSA Reply

		annotation SummarizationSetBy = Automatic

	partition Reviews = m
		mode: import
		source =
				let
				    Source = Csv.Document(Web.Contents("https://raw.githubusercontent.com/KavyaKaushik11/absa-app-reviews/main/data/reviews.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),
				    Kept = Table.SelectColumns(Blanks, {"platform", "review_id", "rating", "title", "text", "app_version", "review_date_local", "review_day", "month", "version", "version_sort", "stars", "sentiment", "replied", "hours_to_reply", "thumbs_up", "reply_text"}),
				    Renamed = Table.RenameColumns(Kept, {{"platform", "Store"}, {"review_id", "Review ID"}, {"rating", "Rating"}, {"title", "Title"}, {"text", "Review"}, {"app_version", "App Version"}, {"review_date_local", "Review Date"}, {"review_day", "Review Day"}, {"month", "Month"}, {"version", "Version"}, {"version_sort", "Version Sort"}, {"stars", "Stars"}, {"sentiment", "Sentiment"}, {"replied", "Replied"}, {"hours_to_reply", "Hours to Reply"}, {"thumbs_up", "Thumbs Up"}, {"reply_text", "ABSA Reply"}}),
				    Typed = Table.TransformColumnTypes(Renamed, {{"Store", type text}, {"Review ID", type text}, {"Rating", Int64.Type}, {"Title", type text}, {"Review", type text}, {"App Version", type text}, {"Review Date", type datetime}, {"Review Day", type date}, {"Month", type date}, {"Version", type text}, {"Version Sort", Int64.Type}, {"Stars", type text}, {"Sentiment", type text}, {"Replied", type text}, {"Hours to Reply", type number}, {"Thumbs Up", Int64.Type}, {"ABSA Reply", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
