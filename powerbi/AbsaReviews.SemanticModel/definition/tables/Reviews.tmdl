table Reviews
	lineageTag: 33da75b7-f296-4152-b34f-6aa06929bc27

	measure 'Review Count' = COUNTROWS(Reviews)
		formatString: #,0
		lineageTag: ecc3fdd4-d7c0-4b87-ba3c-5e550eefa746

	measure 'Average Rating' = AVERAGE(Reviews[Rating])
		formatString: 0.00
		lineageTag: f64cb769-fb71-41d6-b08e-22f7372c7d68

	measure '% Positive' = DIVIDE(CALCULATE(COUNTROWS(Reviews), Reviews[Sentiment] = "Positive"), COUNTROWS(Reviews))
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 92b1e432-88d8-4f33-8ffb-31926520c011

	measure '% Negative' = DIVIDE(CALCULATE(COUNTROWS(Reviews), Reviews[Sentiment] = "Negative"), COUNTROWS(Reviews))
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 789738f4-6619-4125-8cb5-cbf2e49b4240

	measure 'Android Reply Rate' = DIVIDE(CALCULATE(COUNTROWS(Reviews), Reviews[Replied] = "Yes"), CALCULATE(COUNTROWS(Reviews), Reviews[Store] = "Android"))
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 0f1165b1-5be6-4f7e-8273-9fa93b815a59

	measure 'Avg Hours to Reply' = AVERAGE(Reviews[Hours to Reply])
		formatString: #,0.0
		lineageTag: 6dba56dd-016d-43a6-8030-6ff9dbe18444

	measure 'Latest Review' = MAX(Reviews[Review Date])
		formatString: dd mmm yyyy hh:nn
		lineageTag: 7e95aedf-f1f8-47c0-b033-b76351e2cb23

	column 'Store'
		dataType: string
		lineageTag: bb136557-17e4-4914-84b1-93af28cd19d2
		summarizeBy: none
		sourceColumn: Store

		annotation SummarizationSetBy = Automatic

	column 'Review ID'
		dataType: string
		lineageTag: 683c7935-8f9b-4377-b8a5-5bc972d0c2d0
		summarizeBy: none
		sourceColumn: Review ID

		annotation SummarizationSetBy = Automatic

	column 'Rating'
		dataType: int64
		formatString: 0
		lineageTag: a6d3b505-7495-45fa-8ed8-40ef1ceb0494
		summarizeBy: none
		sourceColumn: Rating

		annotation SummarizationSetBy = Automatic

	column 'Title'
		dataType: string
		lineageTag: acdfb4ea-968e-4371-be1c-ca15dbbf75b5
		summarizeBy: none
		sourceColumn: Title

		annotation SummarizationSetBy = Automatic

	column 'Review'
