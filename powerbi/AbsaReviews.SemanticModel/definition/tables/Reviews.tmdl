table Reviews
	lineageTag: fd288e50-4764-471b-9dd5-5b75699ea240

	measure 'Review Count' = COUNTROWS(Reviews)
		formatString: #,0
		lineageTag: 8fc91fa2-50b8-4aa7-a81c-9883c486a400

	measure 'Average Rating' = AVERAGE(Reviews[Rating])
		formatString: 0.00
		lineageTag: c5a5af1d-82a1-4815-8550-b2217eada7f2

	measure '% Positive' = DIVIDE(CALCULATE(COUNTROWS(Reviews), KEEPFILTERS(Reviews[Sentiment] = "Positive")) + 0, COUNTROWS(Reviews))
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: e0326afd-0256-47cb-846a-7f798c2e27ce

	measure '% Negative' = DIVIDE(CALCULATE(COUNTROWS(Reviews), KEEPFILTERS(Reviews[Sentiment] = "Negative")) + 0, COUNTROWS(Reviews))
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 7cbb1f99-6b60-48fe-b2ca-73186a39ae9a

	measure 'Android Reply Rate' = DIVIDE(CALCULATE(COUNTROWS(Reviews), Reviews[Replied] = "Yes"), CALCULATE(COUNTROWS(Reviews), Reviews[Store] = "Android"))
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: b29bd804-624e-4511-9e4a-f5782638fe53

	measure 'Avg Hours to Reply' = AVERAGE(Reviews[Hours to Reply])
		formatString: #,0.0
		lineageTag: d802c64c-3be2-4824-8c88-1a8f30ae8603

	measure 'Latest Review' = MAX(Reviews[Review Date])
		formatString: dd mmm yyyy hh:nn
		lineageTag: 9fbffc33-bf06-4116-a6ba-dccf072ef22c

	column 'Store'
		dataType: string
		lineageTag: 3f7861b4-2c4e-48b1-bbe5-424e017a3bec
		summarizeBy: none
		sourceColumn: Store

		annotation SummarizationSetBy = Automatic

	column 'Review ID'
		dataType: string
		lineageTag: 68af0561-22b9-4c4d-a43c-48fc2736bc1f
		summarizeBy: none
		sourceColumn: Review ID

		annotation SummarizationSetBy = Automatic

	column 'Rating'
		dataType: int64
		formatString: 0
		lineageTag: 7bccb9c9-5d66-4304-afbc-835bf9f32a38
		summarizeBy: none
		sourceColumn: Rating

		annotation SummarizationSetBy = Automatic

	column 'Title'
		dataType: string
		lineageTag: 20654652-4286-43ec-aff3-0f39b275caea
