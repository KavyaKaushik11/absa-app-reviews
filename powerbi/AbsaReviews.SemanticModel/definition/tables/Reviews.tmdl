table Reviews
	lineageTag: b1e562d7-3e14-4c16-b272-afc2b1bba042

	measure 'Review Count' = COUNTROWS(Reviews)
		formatString: #,0
		lineageTag: 86dc818a-3689-461b-957e-b0e56fb742e2

	measure 'Average Rating' = AVERAGE(Reviews[Rating])
		formatString: 0.00
		lineageTag: 75ca6af6-d8c1-4420-9e76-22c4421199c8

	measure '% Positive' = DIVIDE(CALCULATE(COUNTROWS(Reviews), Reviews[Sentiment] = "Positive"), CALCULATE(COUNTROWS(Reviews), ALL(Reviews[Sentiment])))
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 03a2ad63-e75f-4eb3-9649-31a9a0a8c122

	measure '% Negative' = DIVIDE(CALCULATE(COUNTROWS(Reviews), Reviews[Sentiment] = "Negative"), CALCULATE(COUNTROWS(Reviews), ALL(Reviews[Sentiment])))
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 09e8fc28-36a1-496d-b4f1-6c08e0e69ccf

	measure '% Neutral' = DIVIDE(CALCULATE(COUNTROWS(Reviews), Reviews[Sentiment] = "Neutral"), CALCULATE(COUNTROWS(Reviews), ALL(Reviews[Sentiment])))
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 0e3c092b-b2af-4783-be51-68b43b74710a

	measure 'Android Reply Rate' = DIVIDE(CALCULATE(COUNTROWS(Reviews), Reviews[Replied] = "Yes"), CALCULATE(COUNTROWS(Reviews), Reviews[Store] = "Android"))
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 87b6fd54-29b8-43ba-9f9f-f172e58d8831

	measure 'Avg Hours to Reply' = AVERAGE(Reviews[Hours to Reply])
		formatString: #,0.0
		lineageTag: a520057d-0df8-411b-b35f-c6c7dbb782a6

	measure 'Latest Review' = MAX(Reviews[Review Date])
		formatString: dd mmm yyyy hh:nn
		lineageTag: cc8a58f6-5446-4a73-bb86-e38c436a15a0

	column 'Store'
		dataType: string
		lineageTag: fa4b8c00-5df4-4f0e-8f3c-81a206009ce0
		summarizeBy: none
		sourceColumn: Store

		annotation SummarizationSetBy = Automatic

	column 'Review ID'
