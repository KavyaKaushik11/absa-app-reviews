		summarizeBy: none
		sourceColumn: Review Date

		annotation SummarizationSetBy = Automatic

	column 'Review Day'
		dataType: dateTime
		formatString: dd mmm yyyy
		lineageTag: e0a78205-d749-496e-b7f0-4819ab47755a
