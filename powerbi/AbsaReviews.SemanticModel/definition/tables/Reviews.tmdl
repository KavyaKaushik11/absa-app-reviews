table Reviews
	lineageTag: 604e328c-43bf-4793-9556-7c4ad637ae5f

	measure 'Review Count' = COUNTROWS(Reviews)
		formatString: #,0
		lineageTag: 208cef12-9e2a-403b-908e-f12aee3d9b31

	measure 'Average Rating' = AVERAGE(Reviews[Rating])
		formatString: 0.00
		lineageTag: 2ce3bfd5-533e-4691-b987-1c23b988e0dd

	measure '% Positive' = DIVIDE(CALCULATE(COUNTROWS(Reviews), Reviews[Sentiment] = "Positive"), COUNTROWS(Reviews))
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 4c7238d8-9734-4e65-978e-e6add49088e0

	measure '% Negative' = DIVIDE(CALCULATE(COUNTROWS(Reviews), Reviews[Sentiment] = "Negative"), COUNTROWS(Reviews))
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: c9394245-6b84-4b8d-b903-b728a4dd687b

	measure 'Android Reply Rate' = DIVIDE(CALCULATE(COUNTROWS(Reviews), Reviews[Replied] = "Yes"), CALCULATE(COUNTROWS(Reviews), Reviews[Store] = "Android"))
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 1fdd8103-a280-4ff6-aa17-3273fb9f6c17

	measure 'Avg Hours to Reply' = AVERAGE(Reviews[Hours to Reply])
		formatString: #,0.0
		lineageTag: 0fbd3819-164d-4c8e-94f8-d9ca3051c561

	measure 'Latest Review' = MAX(Reviews[Review Date])
		formatString: dd mmm yyyy hh:nn
		lineageTag: 7d38e15d-dceb-4806-8cde-f1675af383ed

	column 'Store'
		dataType: string
		lineageTag: b1dcc248-36c9-4ff7-abce-5f88ad23f7f1
		summarizeBy: none
		sourceColumn: Store

		annotation SummarizationSetBy = Automatic

	column 'Review ID'
		dataType: string
		lineageTag: 0b741fcb-83a7-4e79-8c6f-bda333a80867
		summarizeBy: none
		sourceColumn: Review ID

		annotation SummarizationSetBy = Automatic

	column 'Rating'
		dataType: int64
		formatString: 0
		lineageTag: 50b388a1-fbf0-42ef-a4a6-237039a20cfe
		summarizeBy: none
		sourceColumn: Rating

		annotation SummarizationSetBy = Automatic

	column 'Title'
		dataType: string
		lineageTag: 1f005312-e770-4809-83c2-12173e635802
		summarizeBy: none
		sourceColumn: Title

		annotation SummarizationSetBy = Automatic

	column 'Review'
		dataType: string
		lineageTag: d15cfb88-04f3-494d-a4d9-59f3ae965cb7
		summarizeBy: none
		sourceColumn: Review

		annotation SummarizationSetBy = Automatic

	column 'App Version'
		dataType: string
		lineageTag: c782da40-c7dd-44a6-833b-6f731e1c16e2
		summarizeBy: none
		sourceColumn: App Version

		annotation SummarizationSetBy = Automatic

	column 'Review Date'
		dataType: dateTime
		formatString: dd mmm yyyy hh:nn
		lineageTag: f16b3f39-08eb-49bd-8336-4c4837c46d3e
		summarizeBy: none
		sourceColumn: Review Date

		annotation SummarizationSetBy = Automatic

	column 'Review Day'
		dataType: dateTime
		formatString: dd mmm yyyy
		lineageTag: b2dfb7d5-f06a-46f6-b84a-16fe7ee6c41b
		summarizeBy: none
		sourceColumn: Review Day

		annotation SummarizationSetBy = Automatic

	column 'Month'
		dataType: dateTime
		formatString: mmm yyyy
		lineageTag: 7293e7d8-26ed-4754-9ce3-effc0a61e870
		summarizeBy: none
		sourceColumn: Month

		annotation SummarizationSetBy = Automatic

	column 'Version'
		dataType: string
		lineageTag: e587f264-0f73-4157-b50a-a7785c868f86
		summarizeBy: none
		sourceColumn: Version
		sortByColumn: 'Version Sort'

		annotation SummarizationSetBy = Automatic

	column 'Version Sort'
		dataType: int64
		formatString: 0
		lineageTag: 5fe576e4-7f7b-4592-8b8b-c3c34273feaa
		summarizeBy: none
		sourceColumn: Version Sort

		annotation SummarizationSetBy = Automatic

	column 'Stars'
		dataType: string
		lineageTag: 154609de-70ba-41d7-beab-63f644f90771
		summarizeBy: none
		sourceColumn: Stars
		sortByColumn: 'Rating'

		annotation SummarizationSetBy = Automatic

	column 'Sentiment'
		dataType: string
		lineageTag: 19c281e8-cd54-416b-afc6-e0a02526fc52
		summarizeBy: none
		sourceColumn: Sentiment

		annotation SummarizationSetBy = Automatic

	column 'Replied'
		dataType: string
		lineageTag: eac1ac3a-d30f-4148-98e7-524f11298ae8
		summarizeBy: none
		sourceColumn: Replied

		annotation SummarizationSetBy = Automatic

	column 'Hours to Reply'
		dataType: double
		formatString: #,0.0
		lineageTag: 3c151b66-11f5-4355-9f0f-897a9ef35f70
		summarizeBy: none
		sourceColumn: Hours to Reply

		annotation SummarizationSetBy = Automatic

	column 'Thumbs Up'
		dataType: int64
		formatString: #,0
		lineageTag: 6ecaac88-9310-4af4-ae60-123ef6163be3
		summarizeBy: sum
		sourceColumn: Thumbs Up

		annotation SummarizationSetBy = Automatic

	column 'ABSA Reply'
		dataType: string
		lineageTag: 36956068-033b-4cdb-bcc0-04bbc1a0fee6
		summarizeBy: none
		sourceColumn: ABSA Reply

		annotation SummarizationSetBy = Automatic

	partition Reviews = m
		mode: import
		source =
				let
				    Source = Csv.Document(Web.Contents("https://raw.githubusercontent.com/KavyaKaushik11/absa-app-reviews/main/data/reviews.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),
				    Kept = Table.SelectColumns(Blanks, {"platform", "review_id", "rating", "title", "text", "app_version", "review_date_local", "review_day", "month", "version", "version_sort", "stars", "sentiment", "replied", "hours_to_reply", "thumbs_up", "reply_text"}),
				    Renamed = Table.RenameColumns(Kept, {{"platform", "Store"}, {"review_id", "Review ID"}, {"rating", "Rating"}, {"title", "Title"}, {"text", "Review"}, {"app_version", "App Version"}, {"review_date_local", "Review Date"}, {"review_day", "Review Day"}, {"month", "Month"}, {"version", "Version"}, {"version_sort", "Version Sort"}, {"stars", "Stars"}, {"sentiment", "Sentiment"}, {"replied", "Replied"}, {"hours_to_reply", "Hours to Reply"}, {"thumbs_up", "Thumbs Up"}, {"reply_text", "ABSA Reply"}}),
				    Typed = Table.TransformColumnTypes(Renamed, {{"Store", type text}, {"Review ID", type text}, {"Rating", Int64.Type}, {"Title", type text}, {"Review", type text}, {"App Version", type text}, {"Review Date", type datetime}, {"Review Day", type date}, {"Month", type date}, {"Version", type text}, {"Version Sort", Int64.Type}, {"Stars", type text}, {"Sentiment", type text}, {"Replied", type text}, {"Hours to Reply", type number}, {"Thumbs Up", Int64.Type}, {"ABSA Reply", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
