		summarizeBy: none
		sourceColumn: Version
		sortByColumn: 'Version Sort'

		annotation SummarizationSetBy = Automatic

	column 'Version Sort'
		dataType: int64
		formatString: 0
		lineageTag: b91ab647-7a32-4061-af33-c23123817555
		summarizeBy: none
		sourceColumn: Version Sort

		annotation SummarizationSetBy = Automatic

	column 'Stars'
		dataType: string
		lineageTag: b0004940-5577-410f-bcec-89b0c4ab1c3e
		summarizeBy: none
		sourceColumn: Stars
		sortByColumn: 'Rating'

		annotation SummarizationSetBy = Automatic

	column 'Sentiment'
