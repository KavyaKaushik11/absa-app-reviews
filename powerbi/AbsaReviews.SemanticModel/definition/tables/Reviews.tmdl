		summarizeBy: none
		sourceColumn: Replied

		annotation SummarizationSetBy = Automatic

	column 'Hours to Reply'
		dataType: double
		formatString: #,0.0
		lineageTag: a6675e83-6b16-4403-8f1f-14532fe53ae5
		summarizeBy: none
		sourceColumn: Hours to Reply

		annotation SummarizationSetBy = Automatic

	column 'Thumbs Up'
		dataType: int64
		formatString: #,0
		lineageTag: da533996-69d6-499e-a785-0b49e7782d90
		summarizeBy: sum
		sourceColumn: Thumbs Up

		annotation SummarizationSetBy = Automatic

	column 'ABSA Reply'
		dataType: string
		lineageTag: 61e43a4e-fd58-4e65-a2f1-a717686894a8
		summarizeBy: none
		sourceColumn: ABSA Reply

		annotation SummarizationSetBy = Automatic

	partition Reviews = m
		mode: import
		source =
				let
				    Source = Csv.Document(Web.Contents("https://raw.githubusercontent.com/KavyaKaushik11/absa-app-reviews/main/data/reviews.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),
				    Kept = Table.SelectColumns(Blanks, {"platform", "review_id", "rating", "title", "text", "app_version", "review_date_local", "review_day", "month", "version", "version_sort", "stars", "sentiment", "replied", "hours_to_reply", "thumbs_up", "reply_text"}),
				    Renamed = Table.RenameColumns(Kept, {{"platform", "Store"}, {"review_id", "Review ID"}, {"rating", "Rating"}, {"title", "Title"}, {"text", "Review"}, {"app_version", "App Version"}, {"review_date_local", "Review Date"}, {"review_day", "Review Day"}, {"month", "Month"}, {"version", "Version"}, {"version_sort", "Version Sort"}, {"stars", "Stars"}, {"sentiment", "Sentiment"}, {"replied", "Replied"}, {"hours_to_reply", "Hours to Reply"}, {"thumbs_up", "Thumbs Up"}, {"reply_text", "ABSA Reply"}}),
				    Typed = Table.TransformColumnTypes(Renamed, {{"Store", type text}, {"Review ID", type text}, {"Rating", Int64.Type}, {"Title", type text}, {"Review", type text}, {"App Version", type text}, {"Review Date", type datetime}, {"Review Day", type date}, {"Month", type date}, {"Version", type text}, {"Version Sort", Int64.Type}, {"Stars", type text}, {"Sentiment", type text}, {"Replied", type text}, {"Hours to Reply", type number}, {"Thumbs Up", Int64.Type}, {"ABSA Reply", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
