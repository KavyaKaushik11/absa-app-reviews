		sourceColumn: Version
		sortByColumn: 'Version Sort'

		annotation SummarizationSetBy = Automatic

	column 'Version Sort'
		dataType: int64
		formatString: 0
		lineageTag: c889b7a7-63ac-48ec-ac86-a92cea0c0f0a
		summarizeBy: none
		sourceColumn: Version Sort

		annotation SummarizationSetBy = Automatic

	column 'Stars'
		dataType: string
		lineageTag: 5dd0fd08-c7ac-48c7-aad7-136377a4ba13
		summarizeBy: none
		sourceColumn: Stars
		sortByColumn: 'Rating'

		annotation SummarizationSetBy = Automatic

	column 'Sentiment'
