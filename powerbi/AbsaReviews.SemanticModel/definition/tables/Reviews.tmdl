		summarizeBy: none
		sourceColumn: App Version

		annotation SummarizationSetBy = Automatic

	column 'Review Date'
		dataType: dateTime
		formatString: dd mmm yyyy hh:nn
		lineageTag: ee082052-479f-4706-831a-0dd0e24569b5
		summarizeBy: none
		sourceColumn: Review Date

		annotation SummarizationSetBy = Automatic

	column 'Review Day'
		dataType: dateTime
		formatString: dd mmm yyyy
		lineageTag: 79e45ac2-9370-4aef-b1d1-d62fd331311e
		summarizeBy: none
		sourceColumn: Review Day

		annotation SummarizationSetBy = Automatic

	column 'Month'
		dataType: dateTime
		formatString: mmm yyyy
		lineageTag: e41df2b5-a9a6-4b6d-93ab-bdd78756f7ab
		summarizeBy: none
		sourceColumn: Month

