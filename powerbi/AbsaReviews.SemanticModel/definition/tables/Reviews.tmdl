table Reviews
	lineageTag: cd9e93d9-f6cd-47af-9a33-86e818b3aa6b

	measure 'Review Count' = COUNTROWS(Reviews)
		formatString: #,0
		lineageTag: cab5bc84-78ca-40a5-a629-2f3168317b21

	measure 'Average Rating' = AVERAGE(Reviews[Rating])
		formatString: 0.00
		lineageTag: 2605af1d-daea-401e-a78d-36238af0738c

	measure '% Positive' = DIVIDE(CALCULATE(COUNTROWS(Reviews), Reviews[Rating] >= 4), COUNTROWS(Reviews))
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 90302161-3053-4314-b626-46e578dddee0

	measure '% Negative' = DIVIDE(CALCULATE(COUNTROWS(Reviews), Reviews[Rating] <= 2), COUNTROWS(Reviews))
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 40bd8519-3d45-4428-9066-719060d3c51f

	measure 'Android Reply Rate' = DIVIDE(CALCULATE(COUNTROWS(Reviews), Reviews[Replied] = "Yes"), CALCULATE(COUNTROWS(Reviews), Reviews[Store] = "Android"))
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: ccf31a3c-b4ca-42c3-98e6-331435475b4c

	measure 'Avg Hours to Reply' = AVERAGE(Reviews[Hours to Reply])
		formatString: #,0.0
		lineageTag: d5a4ae50-e9c9-458d-a7cf-9357fb843655

	measure 'Latest Review' = MAX(Reviews[Review Date])
		formatString: dd mmm yyyy hh:nn
		lineageTag: b825e301-cbef-4d91-a612-a34ba9e991c9

	column 'Store'
		dataType: string
		lineageTag: b9b7b0ed-2241-466f-898a-4f4c22fe80e8
		summarizeBy: none
		sourceColumn: Store

		annotation SummarizationSetBy = Automatic

	column 'Review ID'
		dataType: string
		lineageTag: 8a45a5e5-78d2-46fe-8e85-9b48594ac065
		summarizeBy: none
		sourceColumn: Review ID

		annotation SummarizationSetBy = Automatic

	column 'Rating'
		dataType: int64
		formatString: 0
		lineageTag: f464c9b5-0feb-47cb-8414-681c85635520
		summarizeBy: none
		sourceColumn: Rating

		annotation SummarizationSetBy = Automatic

	column 'Title'
		dataType: string
		lineageTag: 6431cb62-4ec0-4ed4-94d5-58d8fcf22281
		summarizeBy: none
		sourceColumn: Title

		annotation SummarizationSetBy = Automatic

	column 'Review'
		dataType: string
		lineageTag: e5889c23-a8bc-403c-b7ed-0129d8617577
		summarizeBy: none
		sourceColumn: Review

		annotation SummarizationSetBy = Automatic

	column 'App Version'
		dataType: string
		lineageTag: 038333c6-d516-40c1-ab3b-a232313c9d76
		summarizeBy: none
		sourceColumn: App Version

		annotation SummarizationSetBy = Automatic

	column 'Review Date'
		dataType: dateTime
		formatString: dd mmm yyyy hh:nn
		lineageTag: 1a5ac637-e05b-4ac4-b48f-690035d3fbd2
		summarizeBy: none
		sourceColumn: Review Date

		annotation SummarizationSetBy = Automatic

	column 'Review Day'
		dataType: dateTime
		formatString: dd mmm yyyy
		lineageTag: d2dea2c3-430e-4ad5-8685-64411d438f7d
		summarizeBy: none
		sourceColumn: Review Day

		annotation SummarizationSetBy = Automatic

	column 'Month'
		dataType: dateTime
		formatString: mmm yyyy
		lineageTag: 6b56c80d-efc1-4f33-82ab-af82861c083a
		summarizeBy: none
		sourceColumn: Month

		annotation SummarizationSetBy = Automatic

	column 'Version'
		dataType: string
		lineageTag: 5da7247a-0022-433c-9272-030186b59904
		summarizeBy: none
		sourceColumn: Version
		sortByColumn: 'Version Sort'

		annotation SummarizationSetBy = Automatic

	column 'Version Sort'
		dataType: int64
		formatString: 0
		lineageTag: 2bb50112-7086-4922-a3da-6eb7a6c00737
		summarizeBy: none
		sourceColumn: Version Sort

		annotation SummarizationSetBy = Automatic

	column 'Stars'
		dataType: string
		lineageTag: 55d188fc-7f55-433f-ab6c-a7e1d54ca9db
		summarizeBy: none
		sourceColumn: Stars
		sortByColumn: 'Rating'

		annotation SummarizationSetBy = Automatic

	column 'Sentiment'
		dataType: string
		lineageTag: 087f6ee1-6590-4203-9f67-9f5771ce0fb2
		summarizeBy: none
		sourceColumn: Sentiment

		annotation SummarizationSetBy = Automatic

	column 'Replied'
		dataType: string
		lineageTag: a1f79961-f8d8-4cad-b3ed-c92c82608d73
		summarizeBy: none
		sourceColumn: Replied

		annotation SummarizationSetBy = Automatic

	column 'Hours to Reply'
		dataType: double
		formatString: #,0.0
		lineageTag: b330711b-3ff2-4099-99d7-7573ddd50a6c
		summarizeBy: none
		sourceColumn: Hours to Reply

		annotation SummarizationSetBy = Automatic

	column 'Thumbs Up'
		dataType: int64
		formatString: #,0
		lineageTag: 9c748d70-9810-44e6-ab88-038112b8b5b5
		summarizeBy: sum
		sourceColumn: Thumbs Up

		annotation SummarizationSetBy = Automatic

	column 'ABSA Reply'
		dataType: string
		lineageTag: 876e64cd-53d1-4432-bbc9-58d91a5c1eab
		summarizeBy: none
		sourceColumn: ABSA Reply

		annotation SummarizationSetBy = Automatic

	partition Reviews = m
		mode: import
		source =
				let
				    Source = Csv.Document(Web.Contents("https://raw.githubusercontent.com/KavyaKaushik11/absa-app-reviews/main/data/reviews.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),
				    Kept = Table.SelectColumns(Blanks, {"platform", "review_id", "rating", "title", "text", "app_version", "review_date_local", "review_day", "month", "version", "version_sort", "stars", "sentiment", "replied", "hours_to_reply", "thumbs_up", "reply_text"}),
				    Renamed = Table.RenameColumns(Kept, {{"platform", "Store"}, {"review_id", "Review ID"}, {"rating", "Rating"}, {"title", "Title"}, {"text", "Review"}, {"app_version", "App Version"}, {"review_date_local", "Review Date"}, {"review_day", "Review Day"}, {"month", "Month"}, {"version", "Version"}, {"version_sort", "Version Sort"}, {"stars", "Stars"}, {"sentiment", "Sentiment"}, {"replied", "Replied"}, {"hours_to_reply", "Hours to Reply"}, {"thumbs_up", "Thumbs Up"}, {"reply_text", "ABSA Reply"}}),
				    Typed = Table.TransformColumnTypes(Renamed, {{"Store", type text}, {"Review ID", type text}, {"Rating", Int64.Type}, {"Title", type text}, {"Review", type text}, {"App Version", type text}, {"Review Date", type datetime}, {"Review Day", type date}, {"Month", type date}, {"Version", type text}, {"Version Sort", Int64.Type}, {"Stars", type text}, {"Sentiment", type text}, {"Replied", type text}, {"Hours to Reply", type number}, {"Thumbs Up", Int64.Type}, {"ABSA Reply", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
