		sortByColumn: 'Version Sort'

		annotation SummarizationSetBy = Automatic

	column 'Version Sort'
		dataType: int64
		formatString: 0
		lineageTag: 4ae5ce61-e37e-4c8a-823e-a2dd12353f78
		summarizeBy: none
		sourceColumn: Version Sort

		annotation SummarizationSetBy = Automatic

	column 'Stars'
		dataType: string
		lineageTag: 759854d5-971f-4349-87e1-866bc2f093d9
		summarizeBy: none
