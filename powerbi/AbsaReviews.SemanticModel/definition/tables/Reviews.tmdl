		annotation SummarizationSetBy = Automatic

	column 'Review Date'
		dataType: dateTime
		formatString: dd mmm yyyy hh:nn
		lineageTag: 03434fc4-2466-40e0-9c06-99ae6b937eda
		summarizeBy: none
		sourceColumn: Review Date

		annotation SummarizationSetBy = Automatic

	column 'Review Day'
		dataType: dateTime
		formatString: dd mmm yyyy
		lineageTag: fc0fbb5f-6fc3-41da-98ff-576b81d49ade
