table Reviews
	lineageTag: 7b329e80-5182-4024-8609-ccf6c5bcadb6

	measure 'Review Count' = COUNTROWS(Reviews)
		formatString: #,0
		lineageTag: f0417342-6d8b-47ac-8b58-d03a542d1a3e

	measure 'Average Rating' = AVERAGE(Reviews[Rating])
		formatString: 0.00
		lineageTag: 952c88a4-0912-4f58-9d88-724a8bdd61cd

	measure '% Positive' = DIVIDE(CALCULATE(COUNTROWS(Reviews), Reviews[Sentiment] = "Positive"), COUNTROWS(Reviews))
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 131842c3-9ad1-488a-938a-2b66f89e9809

	measure '% Negative' = DIVIDE(CALCULATE(COUNTROWS(Reviews), Reviews[Sentiment] = "Negative"), COUNTROWS(Reviews))
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 522232e3-b07d-400b-8e0a-c61007e03c1c

	measure 'Android Reply Rate' = DIVIDE(CALCULATE(COUNTROWS(Reviews), Reviews[Replied] = "Yes"), CALCULATE(COUNTROWS(Reviews), Reviews[Store] = "Android"))
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: f3cd00ae-10d1-4d3e-ae39-75bfe8dd8c98

	measure 'Avg Hours to Reply' = AVERAGE(Reviews[Hours to Reply])
		formatString: #,0.0
		lineageTag: d93605dd-42a3-481c-b462-628979dcf7ca

	measure 'Latest Review' = MAX(Reviews[Review Date])
		formatString: dd mmm yyyy hh:nn
		lineageTag: e1d98fb0-a55a-4ee4-b04c-29c1167a4c04

	column 'Store'
		dataType: string
		lineageTag: 93a26223-c7c9-448a-bebd-4bf8d76be293
		summarizeBy: none
		sourceColumn: Store

		annotation SummarizationSetBy = Automatic

	column 'Review ID'
		dataType: string
		lineageTag: 47f8c9d6-8b46-4d44-a40b-39d1bc0bfd64
		summarizeBy: none
		sourceColumn: Review ID

		annotation SummarizationSetBy = Automatic

	column 'Rating'
		dataType: int64
		formatString: 0
		lineageTag: f9dbda2c-5986-48df-a964-87f467274b9e
		summarizeBy: none
		sourceColumn: Rating

		annotation SummarizationSetBy = Automatic

	column 'Title'
		dataType: string
